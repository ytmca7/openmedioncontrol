<Window x:Class="OpenMedionControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenMedionControl"
        Width="500" Height="860" MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <Grid Margin="2,0,2,14">
                <StackPanel>
                    <TextBlock Text="OpenMedionControl" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="ModelText" Style="{StaticResource Sub}" Text="Medion Erazer Major X10" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" HorizontalAlignment="Right"
                           VerticalAlignment="Bottom" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <UniformGrid Columns="2">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource Sub}" />
                        <TextBlock x:Name="CpuTempText" Text="–" FontSize="28" FontWeight="Light" />
                        <TextBlock x:Name="CpuFanText" Text="–" Style="{StaticResource Sub}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource Sub}" />
                        <TextBlock x:Name="GpuTempText" Text="–" FontSize="28" FontWeight="Light" />
                        <TextBlock x:Name="GpuFanText" Text="–" Style="{StaticResource Sub}" />
                    </StackPanel>
                </UniformGrid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Performance mode" Style="{StaticResource SectionTitle}" />
                    <UniformGrid Columns="3" Margin="-3">
                        <RadioButton x:Name="ModeOffice" GroupName="Mode" Style="{StaticResource Segment}"
                                     Content="Office" Tag="Office" Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeGaming" GroupName="Mode" Style="{StaticResource Segment}"
                                     Content="Gaming" Tag="Gaming" Checked="Mode_Checked" />
                        <RadioButton x:Name="ModeTurbo" GroupName="Mode" Style="{StaticResource Segment}"
                                     Content="Turbo" Tag="Turbo" Checked="Mode_Checked" />
                    </UniformGrid>
                    <TextBlock x:Name="PowerHint" Style="{StaticResource Sub}" Margin="0,10,0,0"
                               Text="Turbo is only available on AC power." Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="System" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="FanBoostSwitch" Style="{StaticResource Switch}" Click="FanBoost_Click">
                        <StackPanel>
                            <TextBlock Text="Max fan speed" />
                            <TextBlock Style="{StaticResource Sub}" Text="Both fans run at full speed." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="UsbPowerSwitch" Style="{StaticResource Switch}" Click="UsbPower_Click">
                        <StackPanel>
                            <TextBlock Text="USB power when off" />
                            <TextBlock Style="{StaticResource Sub}" Text="Charge USB devices while the laptop is shut down." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="WinLockSwitch" Style="{StaticResource Switch}" Click="WinLock_Click">
                        <StackPanel>
                            <TextBlock Text="Lock Windows key" />
                            <TextBlock Style="{StaticResource Sub}" Text="Prevents the Start menu from opening by accident while gaming." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox x:Name="DedicatedGpuSwitch" Style="{StaticResource Switch}" Click="DedicatedGpu_Click">
                        <StackPanel>
                            <TextBlock Text="Dedicated GPU only (MUX)" />
                            <TextBlock Style="{StaticResource Sub}" Text="Display wired directly to the Arc GPU: more performance, more power draw. Requires a restart." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="LightsSwitch" Style="{StaticResource Switch}" Margin="0,0,0,4" Click="Lights_Click">
                        <TextBlock Text="Lighting" Style="{StaticResource SectionTitle}" Margin="0" />
                    </CheckBox>

                    <StackPanel x:Name="LightingPanel">
                        <TextBlock Text="Zone" Style="{StaticResource Label}" />
                        <UniformGrid Columns="4" Margin="-3">
                            <RadioButton GroupName="Zone" Style="{StaticResource Segment}" Content="Keyboard"
                                         Tag="Keyboard" IsChecked="True" Checked="Zone_Checked" />
                            <RadioButton GroupName="Zone" Style="{StaticResource Segment}" Content="Logo"
                                         Tag="Logo" Checked="Zone_Checked" />
                            <RadioButton GroupName="Zone" Style="{StaticResource Segment}" Content="Left"
                                         Tag="LeftSide" Checked="Zone_Checked" />
                            <RadioButton GroupName="Zone" Style="{StaticResource Segment}" Content="Right"
                                         Tag="RightSide" Checked="Zone_Checked" />
                        </UniformGrid>
                        <CheckBox x:Name="AllZonesSwitch" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                  Click="AllZones_Click">
                            <TextBlock Text="Apply changes to all zones" />
                        </CheckBox>

                        <TextBlock Text="Effect" Style="{StaticResource Label}" />
                        <UniformGrid x:Name="EffectGrid" Columns="3" Margin="-3">
                            <RadioButton GroupName="Effect" Style="{StaticResource Segment}" Content="Static"
                                         Tag="Static" Checked="Effect_Checked" />
                            <RadioButton GroupName="Effect" Style="{StaticResource Segment}" Content="Breathe"
                                         Tag="Breath" Checked="Effect_Checked" />
                            <RadioButton GroupName="Effect" Style="{StaticResource Segment}" Content="Wave"
                                         Tag="Wave" Checked="Effect_Checked" />
                            <RadioButton GroupName="Effect" Style="{StaticResource Segment}" Content="Clock"
                                         Tag="Clock" Checked="Effect_Checked" />
                            <RadioButton GroupName="Effect" Style="{StaticResource Segment}" Content="Rainbow"
                                         Tag="Rainbow" Checked="Effect_Checked" />
                            <RadioButton GroupName="Effect" Style="{StaticResource Segment}" Content="Flow"
                                         Tag="Flow" Checked="Effect_Checked" />
                        </UniformGrid>

                        <TextBlock Text="Color" Style="{StaticResource Label}" />
                        <WrapPanel x:Name="SwatchPanel" />
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ColorPreview" Width="28" Height="28" CornerRadius="6" Margin="0,0,8,0"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                            <TextBox x:Name="HexBox" Width="90" VerticalContentAlignment="Center"
                                     KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
                            <Button Content="Pick color…" Margin="8,0,0,0" Padding="10,4" Click="ColorDialog_Click" />
                        </StackPanel>

                        <TextBlock Text="Brightness" Style="{StaticResource Label}" />
                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="255" SmallChange="8" LargeChange="32"
                                ValueChanged="Light_ValueChanged" />

                        <TextBlock x:Name="SpeedLabel" Text="Speed" Style="{StaticResource Label}" />
                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="4" TickFrequency="1"
                                IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                ValueChanged="Light_ValueChanged" />

                        <CheckBox x:Name="ReverseSwitch" Style="{StaticResource Switch}" Margin="0,10,0,0"
                                  Click="Reverse_Click">
                            <TextBlock Text="Reverse direction" />
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" />
                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Click="Autostart_Click">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Style="{StaticResource Sub}" Text="Starts minimized to the tray and restores the lighting." />
                        </StackPanel>
                    </CheckBox>

                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Hardware driver" />
                            <TextBlock x:Name="DriverStatusText" Style="{StaticResource Sub}" />
                        </StackPanel>
                        <Button x:Name="DriverButton" Grid.Column="1" Padding="12,6" VerticalAlignment="Center"
                                Click="Driver_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
